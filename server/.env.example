# Copy to .env for local runs. Never commit a real .env.
PORT=8080
HOST=0.0.0.0

# Matches docker-compose.yml.
DATABASE_URL=postgres://ezpz:ezpz@localhost:5432/ezpzstudy

# Sign auth tokens. MUST be a strong random value in production.
TOKEN_SECRET=dev-only-insecure-secret-change-me
TOKEN_TTL_SECONDS=31536000

# Optional: directory of content_pack_v{N}.json files for local /content/pack.
# In production, packs are served from Cloudflare R2, not the server.
# CONTENT_DIR=../content/packs
