  "instruction_bn": "শূন্যস্থানে সঠিক article (a/an/the) বসাও।",
  "items": [
    { "type": "fill_in_open", "q": "He is ___ M.A. in English.", "a": ["an"], "rule_bn": "M-এর উচ্চারণ 'এম' (স্বরধ্বনি), তাই 'an'।" },
    { "type": "fill_in_open", "q": "___ sun rises in the east.", "a": ["The"], "rule_bn": "একক/অনন্য বস্তুর আগে 'The': The sun।" },
    { "type": "fill_in_open", "q": "She plays ___ piano very well.", "a": ["the"], "rule_bn": "বাদ্যযন্ত্রের আগে 'the': the piano।" },
    { "type": "fill_in_open", "q": "He bought ___ umbrella.", "a": ["an"], "rule_bn": "umbrella স্বরধ্বনি দিয়ে শুরু, তাই 'an'।" },
    { "type": "fill_in_open", "q": "There is ___ hospital near our home.", "a": ["a"], "rule_bn": "hospital ব্যঞ্জনধ্বনি দিয়ে শুরু, তাই 'a'।" },
    { "type": "fill_in_open", "q": "___ Padma is a big river.", "a": ["The"], "rule_bn": "নদীর নামের আগে 'The': The Padma।" },
    { "type": "fill_in_open", "q": "He is ___ honourable person.", "a": ["an"], "rule_bn": "honourable-এ 'h' নীরব, তাই 'an'।" },
    { "type": "fill_in_open", "q": "I read ___ Quran every morning.", "a": ["the"], "rule_bn": "ধর্মগ্রন্থের আগে 'the': the Quran।" },
    { "type": "fill_in_open", "q": "A cow is ___ useful animal.", "a": ["a"], "rule_bn": "useful-এর উচ্চারণ 'ইউ' (ব্যঞ্জন), তাই 'a'।" },
    { "type": "fill_in_open", "q": "He is ___ university teacher.", "a": ["a"], "rule_bn": "university 'ইউ' দিয়ে শুরু, তাই 'a'।" },
    { "type": "fill_in_open", "q": "She is ___ best girl in the class.", "a": ["the"], "rule_bn": "superlative (best)-এর আগে 'the'।" },
    { "type": "fill_in_open", "q": "There is ___ ink in the pot.", "a": ["no article", "-", "some"], "fuzzy": 0, "rule_bn": "uncountable noun (ink)-এর আগে সাধারণত a/an বসে না।" },
    { "type": "fill_in_open", "q": "He went to ___ school at nine.", "a": ["-", "no article"], "fuzzy": 0, "rule_bn": "উদ্দেশ্য বোঝাতে (পড়তে যাওয়া) 'school'-এর আগে article বসে না।" },
    { "type": "fill_in_open", "q": "The Himalayas is ___ highest mountain range.", "a": ["the"], "rule_bn": "superlative-এর আগে 'the'।" },
    { "type": "fill_in_open", "q": "He is ___ European by birth.", "a": ["a"], "rule_bn": "European 'ইউ' দিয়ে শুরু, তাই 'a'।" },
    { "type": "fill_in_open", "q": "I saw ___ one-eyed man.", "a": ["a"], "rule_bn": "one-এর উচ্চারণ 'ওয়ান' (ব্যঞ্জন), তাই 'a'।" },
    { "type": "fill_in_open", "q": "Dhaka is ___ capital of Bangladesh.", "a": ["the"], "rule_bn": "অনন্য পদের আগে 'the': the capital।" },
    { "type": "fill_in_open", "q": "He gave me ___ hour to finish.", "a": ["an"], "rule_bn": "hour-এ 'h' নীরব, তাই 'an'।" },
    { "type": "fill_in_open", "q": "Rice is ___ food we eat daily.", "a": ["the"], "rule_bn": "নির্দিষ্ট করে বোঝাতে 'the'।" },
    { "type": "fill_in_open", "q": "She wants to be ___ engineer.", "a": ["an"], "rule_bn": "engineer স্বরধ্বনি দিয়ে শুরু, তাই 'an'।" },
    { "type": "fill_in_open", "q": "___ rich should help the poor.", "a": ["The"], "rule_bn": "'The + adjective' জাতি বোঝায়: The rich।" },
    { "type": "fill_in_open", "q": "He travelled by ___ train.", "a": ["-", "no article"], "fuzzy": 0, "rule_bn": "যানবাহনে 'by train'-এ article বসে না।" },
    { "type": "fill_in_open", "q": "It was ___ unique experience.", "a": ["a"], "rule_bn": "unique 'ইউ' দিয়ে শুরু, তাই 'a'।" },
    { "type": "fill_in_open", "q": "The moon is ___ satellite of the earth.", "a": ["a"], "rule_bn": "অনেকের একটি বোঝাতে 'a satellite'।" }
  ]
}
