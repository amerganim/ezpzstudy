  "items": [
    { "type": "mcq", "q": "Which word is a pronoun?", "opts": ["dog", "she", "run", "blue"], "correct": 1, "rule_bn": "Noun-এর পরিবর্তে বসে pronoun: 'she'।" },
    { "type": "mcq", "q": "Which word is an adverb?", "opts": ["quick", "quickly", "quickness", "quicken"], "correct": 1, "rule_bn": "verb-এর ধরন বোঝায় adverb: 'quickly'।" },
    { "type": "mcq", "q": "Which word is a preposition?", "opts": ["under", "happy", "jump", "they"], "correct": 0, "rule_bn": "সম্পর্ক বোঝায় preposition: 'under'।" },
    { "type": "mcq", "q": "Which word is a conjunction?", "opts": ["and", "table", "slowly", "red"], "correct": 0, "rule_bn": "সংযোগকারী শব্দ conjunction: 'and'।" },
    { "type": "mcq", "q": "Which word is an interjection?", "opts": ["Alas!", "book", "write", "tall"], "correct": 0, "rule_bn": "আবেগ প্রকাশ করে interjection: 'Alas!'।" },
    { "type": "mcq", "q": "In 'She sings sweetly', which word is the adverb?", "opts": ["She", "sings", "sweetly", "none"], "correct": 2, "rule_bn": "কীভাবে গায় বোঝায় 'sweetly' (adverb)।" },
    { "type": "mcq", "q": "In 'The red car is fast', which word is the adjective?", "opts": ["The", "red", "car", "is"], "correct": 1, "rule_bn": "গুণ বোঝায় adjective: 'red'।" },
    { "type": "mcq", "q": "Which is a proper noun?", "opts": ["river", "Dhaka", "city", "boy"], "correct": 1, "rule_bn": "নির্দিষ্ট নাম proper noun: 'Dhaka'।" },
    { "type": "mcq", "q": "Which is a collective noun?", "opts": ["team", "player", "ball", "field"], "correct": 0, "rule_bn": "সমষ্টি বোঝায় collective noun: 'team'।" },
    { "type": "mcq", "q": "Which word is a verb in 'They play football'?", "opts": ["They", "play", "football", "none"], "correct": 1, "rule_bn": "কাজ বোঝায় verb: 'play'।" },
    { "type": "mcq", "q": "Which word is an abstract noun?", "opts": ["honesty", "chair", "dog", "tree"], "correct": 0, "rule_bn": "গুণ/ভাব বোঝায় abstract noun: 'honesty'।" },
    { "type": "mcq", "q": "'Wow! What a scene!' — 'Wow' is a/an ___.", "opts": ["noun", "verb", "interjection", "adverb"], "correct": 2, "rule_bn": "আবেগ প্রকাশ করে interjection।" },
    { "type": "mcq", "q": "In 'He runs but she walks', 'but' is a ___.", "opts": ["preposition", "conjunction", "adverb", "pronoun"], "correct": 1, "rule_bn": "দুই বাক্য যোগ করে conjunction: 'but'।" },
    { "type": "mcq", "q": "Which word is a common noun?", "opts": ["Karim", "boy", "Dhaka", "Padma"], "correct": 1, "rule_bn": "সাধারণ নাম common noun: 'boy'।" },
    { "type": "mcq", "q": "In 'The bird flew over the tree', 'over' is a ___.", "opts": ["verb", "preposition", "noun", "adjective"], "correct": 1, "rule_bn": "অবস্থান বোঝায় preposition: 'over'।" },
    { "type": "mcq", "q": "Which word is an adjective in 'It is a beautiful garden'?", "opts": ["It", "beautiful", "garden", "is"], "correct": 1, "rule_bn": "গুণ বোঝায় adjective: 'beautiful'।" },
    { "type": "mcq", "q": "Which word is a pronoun in 'This is mine'?", "opts": ["This", "is", "mine", "both This and mine"], "correct": 3, "rule_bn": "'This' ও 'mine' দুটোই pronoun।" },
    { "type": "mcq", "q": "'quickly', 'slowly', 'nicely' are all ___.", "opts": ["nouns", "verbs", "adverbs", "adjectives"], "correct": 2, "rule_bn": "-ly যুক্ত এসব শব্দ adverb।" },
    { "type": "mcq", "q": "Which word is a verb?", "opts": ["decision", "decide", "decisive", "decisively"], "correct": 1, "rule_bn": "কাজ বোঝায় verb: 'decide'।" },
    { "type": "mcq", "q": "Which word is a noun?", "opts": ["freedom", "free", "freely", "none"], "correct": 0, "rule_bn": "নাম/ভাব বোঝায় noun: 'freedom'।" },
    { "type": "mcq", "q": "In 'Oh! I have lost my pen', 'Oh' is a/an ___.", "opts": ["interjection", "conjunction", "noun", "verb"], "correct": 0, "rule_bn": "আবেগ প্রকাশ করে interjection।" },
    { "type": "mcq", "q": "Which is a material noun?", "opts": ["gold", "ring", "shop", "man"], "correct": 0, "rule_bn": "পদার্থ বোঝায় material noun: 'gold'।" },
    { "type": "mcq", "q": "In 'We waited until noon', 'until' is a ___.", "opts": ["preposition", "adjective", "pronoun", "interjection"], "correct": 0, "rule_bn": "সময়-সম্পর্ক বোঝায় preposition: 'until'।" },
    { "type": "mcq", "q": "Which word is an adjective?", "opts": ["care", "careful", "carefully", "cares"], "correct": 1, "rule_bn": "গুণ বোঝায় adjective: 'careful'।" },
    { "type": "mcq", "q": "In 'She is very kind', 'very' is a/an ___.", "opts": ["adjective", "adverb", "noun", "verb"], "correct": 1, "rule_bn": "adjective-এর মাত্রা বোঝায় adverb: 'very'।" },
    { "type": "mcq", "q": "Which word is a pronoun?", "opts": ["everybody", "everywhere", "everyday", "every"], "correct": 0, "rule_bn": "সবাইকে বোঝাতে pronoun: 'everybody'।" },
    { "type": "mcq", "q": "In 'He and I are friends', 'and' joins two ___.", "opts": ["verbs", "subjects", "objects", "adjectives"], "correct": 1, "rule_bn": "'and' দুটি subject (He, I) যোগ করেছে।" },
    { "type": "mcq", "q": "Which word shows action?", "opts": ["swim", "water", "wet", "deep"], "correct": 0, "rule_bn": "কাজ বোঝায় verb: 'swim'।" },
    { "type": "mcq", "q": "'in', 'on', 'at', 'by' are all ___.", "opts": ["conjunctions", "prepositions", "adverbs", "nouns"], "correct": 1, "rule_bn": "এগুলো সব preposition।" },
    { "type": "mcq", "q": "Which word is an abstract noun?", "opts": ["kindness", "kind", "kindly", "none"], "correct": 0, "rule_bn": "ভাব বোঝায় abstract noun: 'kindness'।" },
    { "type": "mcq", "q": "In 'Run fast!', 'fast' is a/an ___.", "opts": ["noun", "adverb", "conjunction", "pronoun"], "correct": 1, "rule_bn": "কীভাবে দৌড়াও বোঝায় adverb: 'fast'।" },
    { "type": "mcq", "q": "Which word is a conjunction?", "opts": ["because", "beautiful", "beside", "behave"], "correct": 0, "rule_bn": "কারণ যোগ করে conjunction: 'because'।" },
    { "type": "mcq", "q": "Which is a countable noun?", "opts": ["water", "book", "milk", "air"], "correct": 1, "rule_bn": "গোনা যায় এমন noun countable: 'book'।" },
    { "type": "mcq", "q": "Which is an uncountable noun?", "opts": ["pen", "chair", "sugar", "table"], "correct": 2, "rule_bn": "গোনা যায় না এমন noun uncountable: 'sugar'।" }
  ]
