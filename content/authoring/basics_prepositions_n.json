  "instruction_bn": "শূন্যস্থানে সঠিক preposition বসাও।",
  "items": [
    { "type": "fill_in_open", "q": "He is good ___ mathematics.", "a": ["at"], "rule_bn": "'good at' — কোনো বিষয়ে দক্ষ।" },
    { "type": "fill_in_open", "q": "She is fond ___ music.", "a": ["of"], "rule_bn": "'fond of' — অনুরাগী।" },
    { "type": "fill_in_open", "q": "The train arrived ___ time.", "a": ["on", "in"], "fuzzy": 0, "rule_bn": "'on time' — সময়মতো; 'in time' — সময়ের মধ্যে।" },
    { "type": "fill_in_open", "q": "I met him ___ Friday.", "a": ["on"], "rule_bn": "বারের আগে 'on': on Friday।" },
    { "type": "fill_in_open", "q": "We live ___ Bangladesh.", "a": ["in"], "rule_bn": "দেশ/বড় জায়গার আগে 'in'।" },
    { "type": "fill_in_open", "q": "The cat jumped ___ the wall.", "a": ["over"], "rule_bn": "উপর দিয়ে লাফ বোঝাতে 'over'।" },
    { "type": "fill_in_open", "q": "He is angry ___ me.", "a": ["with"], "rule_bn": "কারো ওপর রাগ: 'angry with' (ব্যক্তির ক্ষেত্রে)।" },
    { "type": "fill_in_open", "q": "She is afraid ___ snakes.", "a": ["of"], "rule_bn": "'afraid of' — ভয় পাওয়া।" },
    { "type": "fill_in_open", "q": "The book is ___ the bag.", "a": ["in", "inside"], "fuzzy": 0, "rule_bn": "ভেতরে বোঝাতে 'in/inside'।" },
    { "type": "fill_in_open", "q": "He died ___ cholera.", "a": ["of", "from"], "fuzzy": 0, "rule_bn": "রোগে মৃত্যু: 'die of/from'।" },
    { "type": "fill_in_open", "q": "We should abide ___ the rules.", "a": ["by"], "rule_bn": "'abide by' — মেনে চলা।" },
    { "type": "fill_in_open", "q": "He walked ___ the road.", "a": ["along", "down", "on"], "fuzzy": 0, "rule_bn": "রাস্তা ধরে হাঁটা: 'along/down'।" },
    { "type": "fill_in_open", "q": "The meeting will begin ___ 10 a.m.", "a": ["at"], "rule_bn": "নির্দিষ্ট সময়ের আগে 'at': at 10 a.m।" },
    { "type": "fill_in_open", "q": "She is married ___ a doctor.", "a": ["to"], "rule_bn": "'married to' — বিবাহিত।" },
    { "type": "fill_in_open", "q": "The picture hangs ___ the wall.", "a": ["on"], "rule_bn": "দেয়ালে ঝোলানো বোঝাতে 'on'।" },
    { "type": "fill_in_open", "q": "He jumped ___ the river.", "a": ["into"], "rule_bn": "ভেতরে ঢোকা বোঝাতে 'into'।" },
    { "type": "fill_in_open", "q": "I have been waiting ___ two hours.", "a": ["for"], "rule_bn": "সময়ের ব্যাপ্তি বোঝাতে 'for'।" },
    { "type": "fill_in_open", "q": "He is senior ___ me.", "a": ["to"], "rule_bn": "senior/junior-এর পরে 'to'।" },
    { "type": "fill_in_open", "q": "The sweets are divided ___ the children.", "a": ["among"], "rule_bn": "দুইয়ের বেশি হলে 'among'।" },
    { "type": "fill_in_open", "q": "The gift is ___ you and me.", "a": ["between"], "rule_bn": "দুইয়ের মধ্যে হলে 'between'।" },
    { "type": "fill_in_open", "q": "He comes ___ a rich family.", "a": ["of", "from"], "fuzzy": 0, "rule_bn": "'come of/from a family' — বংশ বোঝায়।" },
    { "type": "fill_in_open", "q": "Put the pen ___ the box.", "a": ["in", "into", "inside"], "fuzzy": 0, "rule_bn": "ভেতরে রাখা বোঝাতে 'in/into'।" },
    { "type": "fill_in_open", "q": "The sun sets ___ the west.", "a": ["in"], "rule_bn": "দিকের আগে 'in': in the west।" },
    { "type": "fill_in_open", "q": "He is sitting ___ his friends.", "a": ["with", "among", "beside"], "fuzzy": 0, "rule_bn": "সঙ্গে বোঝাতে 'with/among/beside'।" }
  ]
}
